{
  "name": "mimi-seed",
  "keywords": ["release-doctor", "expo", "react-native", "unity", "google-play", "app-store", "release-readiness", "mcp", "cli"],
  "version": "0.19.18",
  "description": "Release Doctor: check Expo, React Native and Unity release risks before connecting app stores.",
  "bin": {
    "mimi-seed": "dist/index.js"
  },
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://mimi-seed.pryzm.gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeonghwanko/mimi-seed-sdk.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/sync-release-doctor.mjs --check",
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../../scripts/sync-release-doctor.mjs --check",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "kleur": "^4.1.5",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}

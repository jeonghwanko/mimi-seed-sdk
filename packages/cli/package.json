{
  "name": "mimi-seed",
  "keywords": [
    "release-doctor",
    "expo",
    "react-native",
    "unity",
    "google-play",
    "app-store",
    "release-readiness",
    "mcp",
    "cli"
  ],
  "version": "0.23.2",
  "description": "Release Doctor: check Expo, React Native and Unity release risks before connecting app stores.",
  "bin": {
    "mimi-seed": "dist/index.js"
  },
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://mimi-seed.pryzm.gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeonghwanko/mimi-seed-sdk.git",
    "directory": "packages/cli"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "kleur": "^4.1.5",
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.12.0"
  }
}

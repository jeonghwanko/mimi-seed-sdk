{
  "name": "@yoonion/mimi-seed-mcp",
  "version": "0.22.0",
  "description": "Mimi Seed MCP server \u2014 Firebase + AdMob + Google Play + App Store management for Claude Code / Codex / Cursor / any MCP client.",
  "type": "module",
  "imports": {
    "#core/*": "./dist/core/*"
  },
  "bin": {
    "mimi-seed-mcp": "dist/index.js",
    "mimi-seed-auth": "dist/auth/cli.js",
    "mimi-seed-appstore-auth": "dist/appstore/setup-cli.js",
    "mimi-seed-playstore-auth": "dist/auth/playstore-setup-cli.js",
    "mimi-seed-bigquery-auth": "dist/auth/bigquery-setup-cli.js",
    "mimi-seed-drive-auth": "dist/auth/drive-setup-cli.js",
    "mimi-seed-jenkins-auth": "dist/jenkins/setup-cli.js",
    "mimi-seed-googleads-auth": "dist/googleads/setup-cli.js",
    "mimi-seed-social-auth": "dist/social/setup-cli.js",
    "mimi-seed-tiktok-business-auth": "dist/tiktok-business/setup-cli.js",
    "mimi-seed-firebase": "dist/firebase/cli.js",
    "mimi-seed-admob": "dist/admob/cli.js",
    "mimi-seed-ga4": "dist/ga4/cli.js",
    "mimi-seed-release-doctor": "dist/checks/release-doctor-cli.js"
  },
  "files": [
    "dist",
    "scripts/googleads-report.mjs",
    "assets",
    "tool-manifest.json",
    "LICENSE"
  ],
  "scripts": {
    "report:googleads": "node scripts/googleads-report.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.core.json && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json && tsc -p ../core",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/sync-agent-guide.mjs --check && npm run build",
    "lint": "eslint . ../core",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "codex",
    "firebase",
    "admob",
    "google-play",
    "app-store",
    "mimi-seed"
  ],
  "homepage": "https://mimi-seed.pryzm.gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeonghwanko/mimi-seed-sdk.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "gaxios": "7.1.5"
  },
  "dependencies": {
    "@googleapis/admob": "~7.0.0",
    "@googleapis/analyticsadmin": "~18.0.1",
    "@googleapis/analyticsdata": "~6.0.0",
    "@googleapis/androidpublisher": "~38.0.0",
    "@googleapis/bigquery": "~23.0.0",
    "@googleapis/billingbudgets": "~5.0.1",
    "@googleapis/cloudbilling": "~10.0.0",
    "@googleapis/cloudresourcemanager": "~7.0.0",
    "@googleapis/drive": "~22.0.0",
    "@googleapis/firebase": "~13.0.0",
    "@googleapis/iam": "~38.0.1",
    "@googleapis/monitoring": "~14.0.0",
    "@googleapis/searchconsole": "~7.1.0",
    "@googleapis/serviceusage": "~24.0.0",
    "@googleapis/youtube": "~35.0.0",
    "@googleapis/youtubeanalytics": "~7.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@onesub/providers": "^0.5.0",
    "jose": "^6.2.18",
    "open": "^11.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^1.12.0"
  }
}

{
  "name": "@yoonion/mimi-seed-mcp",
  "version": "0.20.0",
  "description": "Mimi Seed MCP server — Firebase + AdMob + Google Play + App Store management for Claude Code / Codex / Cursor / any MCP client.",
  "type": "module",
  "imports": {
    "#core/*": "./dist/core/*"
  },
  "bin": {
    "mimi-seed-mcp": "dist/index.js",
    "mimi-seed-auth": "dist/auth/cli.js",
    "mimi-seed-appstore-auth": "dist/appstore/setup-cli.js",
    "mimi-seed-playstore-auth": "dist/auth/playstore-setup-cli.js",
    "mimi-seed-bigquery-auth": "dist/auth/bigquery-setup-cli.js",
    "mimi-seed-jenkins-auth": "dist/jenkins/setup-cli.js",
    "mimi-seed-googleads-auth": "dist/googleads/setup-cli.js",
    "mimi-seed-social-auth": "dist/social/setup-cli.js",
    "mimi-seed-tiktok-business-auth": "dist/tiktok-business/setup-cli.js",
    "mimi-seed-firebase": "dist/firebase/cli.js",
    "mimi-seed-admob": "dist/admob/cli.js",
    "mimi-seed-ga4": "dist/ga4/cli.js",
    "mimi-seed-release-doctor": "dist/checks/release-doctor-cli.js"
  },
  "files": [
    "dist",
    "scripts/googleads-report.mjs",
    "assets",
    "tool-manifest.json",
    "LICENSE"
  ],
  "scripts": {
    "report:googleads": "node scripts/googleads-report.mjs",
    "build": "tsc -p tsconfig.core.json && tsc",
    "dev": "tsx --tsconfig tsconfig.lint.json src/index.ts",
    "auth": "tsx --tsconfig tsconfig.lint.json src/auth/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json && tsc -p ../core",
    "test": "npm run typecheck && npm run lint && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/sync-agent-guide.mjs --check && npm run build",
    "lint": "eslint . ../core",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "codex",
    "firebase",
    "admob",
    "google-play",
    "app-store",
    "mimi-seed"
  ],
  "homepage": "https://mimi-seed.pryzm.gg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeonghwanko/mimi-seed-sdk.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "gaxios": "7.1.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@onesub/providers": "^0.4.4",
    "googleapis": "~178.0.0",
    "jose": "^6.2.12",
    "open": "^11.0.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
